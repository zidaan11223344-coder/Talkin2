# Copy this file to .env for local development and replace every placeholder.
BOT_ID=your_bot_username
BOT_PWD=your_bot_password
BOT_MASTER=your_master_username
GROUP_TO_JOIN=your_room_name
# Netscape cookies text exported from a YouTube account; needed if YouTube asks for bot verification.
YOUTUBE_COOKIES=
PUBLIC_BASE_URL=
GIFT_PUBLIC_BASE_URL=
PIPED_APIS=
MUSIC_MAX_SECONDS=900
MUSIC_COOLDOWN=15

# Safe TalkinChat text packet size; list entries are sent one per message.
TALKIN_TEXT_LIMIT=180
# Private MP3 delivery as a downloadable file attachment.
PRIVATE_AUDIO_TYPE=file
# Experimental live-room flow used by: بث اسم الأغنية
STREAM_EXPERIMENTAL_ENABLED=1
STREAM_INVITE_ACTION=stream_invite
STREAM_ACCEPT_ACTION=stream_accept
STREAM_AUDIO_ACTION=stream_audio
STREAM_ROOM_ACTION=room_stream
STREAM_ROOM_TYPE=publish
STREAM_ACCEPT_STATE=accept
STREAM_ACCEPT_DELAY=0.8
STREAM_AUDIO_DELAY=0.8
# The bot sends a native self-invitation, then handles you_invited with
# room_stream type=publish. Set to 1 only for manual app invitations.
STREAM_MANUAL_ACCEPT_ONLY=0
# JSONL diagnostics for failed live-seat invitation acceptance.
STREAM_ERROR_LOG_FILE=data/stream_accept_errors.log

# Automatic Railway cleanup: removes old song/cache leftovers hourly while
# preserving data/ and bot_data/ persistent records.
CLEANUP_AUDIO_ENABLED=1
CLEANUP_CACHE_ENABLED=1
CLEANUP_TMP_ENABLED=1
CLEANUP_LOG_ENABLED=1
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_MAX_AGE_SECONDS=3600

# Telegram diagnostics. Send any message to the Telegram bot once, then use
# سجل or نسخ المتغيرات from the Talkin master account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_COMMANDS=سجل,السجل,ارسال السجل,send log,log
TELEGRAM_VARIABLE_COMMANDS=نسخ المتغيرات,متغيرات,variables
TELEGRAM_POLL_SECONDS=2

# Persistent backup repository. `انسخ احتياطي` uploads JSON state files only.
GITHUB_SYNC=1
GITHUB_REPO=zidaan11223344-coder/Talkin4
GITHUB_BRANCH=main
GITHUB_DATA_DIR=bot_data
GITHUB_TOKEN=
