# Public/runtime defaults for Railway and local development.
# The bot reads non-empty values from this tracked file automatically.
# Keep only these values in Railway Variables: BOT_ID, BOT_PWD/BOT_PASSWORD,
# BOT_MASTER/MASTER_ID/MASTER_PWD, GITHUB_TOKEN, TELEGRAM_BOT_TOKEN, and
# YOUTUBE_COOKIES/YOUTUBE_COOKIES_FILE.
BOT_ID=
BOT_PWD=
BOT_PASSWORD=
BOT_MASTER=
MASTER_ID=
MASTER_USERNAME=
MASTER_PWD=
GROUP_TO_JOIN=your_room_name
# Railway runtime data directory. Use a dedicated test volume for this bot.
BOT_DATA_DIR=/app/data
# Public HTTPS domain used to deliver cricket PNG images and result cards.
RAILWAY_PUBLIC_DOMAIN=
RAVEN_PUBLIC_DOMAIN=
ASSET_HTTP_ENABLED=1
# Netscape cookies text exported from a YouTube account; needed if YouTube asks for bot verification.
YOUTUBE_COOKIES=
# Alternative to inline cookies: absolute path to a mounted Netscape-format cookie file.
YOUTUBE_COOKIES_FILE=
# Optional Spotify Developer app credentials for catalog search by text.
# Spotify links can also be resolved through public oEmbed without credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PUBLIC_BASE_URL=
GIFT_PUBLIC_BASE_URL=
# Emergency workaround only while chatp.net has an expired certificate.
# Set back to 0 (or remove it) immediately after the certificate is fixed.
ALLOW_INSECURE_TLS=0
PIPED_APIS=
MUSIC_MAX_SECONDS=900
MUSIC_COOLDOWN=15

# Safe TalkinChat text packet size; list entries are sent one per message.
TALKIN_TEXT_LIMIT=180
# Per-user cooldown for the billion game, in seconds (default: 60).
BILLION_GAME_COOLDOWN_SECONDS=60
# Work/salary: a new random job may be taken once per user every 10 minutes.
PAYROLL_COOLDOWN_SECONDS=600
# Stock market: announce/open a round every 15 minutes; settle investments after 1 minute.
STOCK_MARKET_INTERVAL_SECONDS=600
STOCK_MARKET_SETTLEMENT_SECONDS=60
# Per-user cooldown between fishing shots and between separate stock investments (2 minutes).
FISHING_SHOT_COOLDOWN_SECONDS=120
STOCK_MARKET_PLAYER_COOLDOWN_SECONDS=120
# Private MP3 delivery as a downloadable file attachment.
PRIVATE_AUDIO_TYPE=file
# Experimental live-room flow used by: بث اسم الأغنية
STREAM_EXPERIMENTAL_ENABLED=1
STREAM_INVITE_ACTION=stream_invite
STREAM_ACCEPT_ACTION=stream_accept
STREAM_AUDIO_ACTION=stream_audio
STREAM_ROOM_ACTION=room_stream
STREAM_ROOM_TYPE=publish
STREAM_ACCEPT_STATE=accept
STREAM_ACCEPT_DELAY=0.8
STREAM_AUDIO_DELAY=0.8
# The bot sends a native self-invitation, then handles you_invited with
# room_stream type=publish. Set to 1 only for manual app invitations.
STREAM_MANUAL_ACCEPT_ONLY=0
# JSONL diagnostics for failed live-seat invitation acceptance.
STREAM_ERROR_LOG_FILE=data/stream_accept_errors.log

# Automatic Railway cleanup: removes old song/cache leftovers hourly while
# preserving data/ and bot_data/ persistent records.
CLEANUP_AUDIO_ENABLED=1
CLEANUP_CACHE_ENABLED=1
CLEANUP_TMP_ENABLED=1
CLEANUP_LOG_ENABLED=1
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_MAX_AGE_SECONDS=3600

# Telegram diagnostics and automatic connection-recovery notices.
# Send any message to the Telegram bot once to capture its chat ID; `سجل` and
# `نسخ المتغيرات` remain available from the Talkin master account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LONG_TEXT_ENABLED=1
TELEGRAM_LOG_COMMANDS=سجل,السجل,ارسال السجل,send log,log
TELEGRAM_VARIABLE_COMMANDS=نسخ المتغيرات,متغيرات,variables
TELEGRAM_POLL_SECONDS=2

# Persistent backup repository. `انسخ احتياطي` uploads JSON state files only.
GITHUB_SYNC=0
GITHUB_REPO=zidaan11223344-coder/Talkin-ID-Data
GITHUB_BRANCH=main
GITHUB_DATA_DIR=bot_data
GITHUB_TOKEN=
GITHUB_BACKUP_WAIT_SECONDS=20
# Optional SQL state store; disabled for this isolated GitHub-JSON test setup.
RIVEN_DATABASE_NAME=talkin_id_test_db
RIVEN_DATABASE_URL=
RIVEN_DB_HOST=
RIVEN_DB_PORT=3306
RIVEN_DB_USER=
RIVEN_DB_PASSWORD=
RIVEN_DATABASE_KIND=mysql
# Full JSON backup to Talkin-ID-Data every 6 hours when PostgreSQL is enabled.
DATABASE_BACKUP_INTERVAL_SECONDS=21600
# Keep 0 to avoid a GitHub API write for every local state change.
GITHUB_JSON_MIRROR=0

# Cricket: only BOT_MASTER may send `.cr 1` to enable or `.cr 0` to disable
# (also accepts the Arabic and English full commands) in a private message.
# Mount a persistent volume at /data and set BOT_DATA_DIR=/data/talkin2.
# Match state and result cards live under BOT_DATA_DIR.

# Complete runtime variable catalog. Empty entries use safe code defaults or
# remain disabled; sensitive entries must be supplied only through Railway.
ACK_ROOM_EVENTS=1
ADMIN_CONFIRMATION_TIMEOUT=8
ALLOW_TEXT_ROOM_LIST_FALLBACK=1
API_BASE_URL=https://chatp.net/api?
AUDIUS_API_BASE=https://api.audius.co/v1
AUDIUS_API_KEY=
AUDIUS_API_CACHE_TTL=300
AUDIUS_API_TIMEOUT=1.8
AUDIUS_CACHE_TTL=300
AUDIUS_TIMEOUT=1.8
AUTO_BAN_WORDS=0
AUTO_HELP=1
AUTO_JOIN_ALL_ROOMS=0
AUTO_JOIN_ROOMS=0
BANNED_WORDS=
BOOTSTRAP_WAIT=2
BOT_BASE_STATUS=
BOT_FIRST_CONNECTION_STATUS=
BOT_USERNAME=
CAPTCHA_ID=0
CLEANUP_GENERATED_ENABLED=1
CLEANUP_MEMORY_ENABLED=1
CLEANUP_MEMORY_MAX_AGE_SECONDS=1800
CONNECTION_NOTICE_COOLDOWN=300
CPU_GUARD_ENABLED=1
CPU_GUARD_HIGH_PERCENT=50
CPU_GUARD_INTERVAL_SECONDS=3600
CPU_GUARD_LOG_COOLDOWN_SECONDS=15
CPU_GUARD_RECOVER_PERCENT=35
DATABASE_URL=
DB_CONFIG_PATH=
DB_HOST=
DB_NAME=talkin_bot_db
DB_PASSWORD=
DB_PORT=3306
DB_TYPE=mysql
DB_USER=
DEBUG=0
DEVICE_MODEL=
EVENT_QUEUE_MAX=1000
FAST_ROOM_RESTORE_DELAY_SECONDS=1.2
FFMPEG_NICE=10
FFMPEG_THREADS=2
FIRST_ROOM=
GLOBAL_BAN_DELAY_SECONDS=0.25
HELP_LINES_PER_MESSAGE=10
HELP_PACKET_MAX_CHARS=900
HOST_HEADER=chatp.net
INVITE_SENDER_NAME=السفير
INVITE_SEND_INTERVAL_SECONDS=1.5
JOIN_ALL_ROOMS=0
JOIN_CONFIRM_TIMEOUT_SECONDS=20
JOIN_DEBOUNCE_SECONDS=20
LANGUAGE=
LIST_BOOTSTRAP_WAIT=0.5
LIVEKIT_URL=
# Do not copy room command/message text into Railway runtime logs.
LOG_ROOM_MESSAGES=0
# Successful per-file backup logs are off; upload failures still remain visible.
LOG_GITHUB_SYNC_SUCCESS=0
# Keep routine diagnostics quiet unless temporarily troubleshooting.
QUIET_MODE=1
MASTER_DISPLAY_NAME=
MASTER_SUPPORT_USERNAME=
MUSIC_BUFFER_SIZE=4194304
MUSIC_CONCURRENT_FRAGMENTS=16
MUSIC_DIRECT_CACHE_TTL=300
MUSIC_HTTP_CHUNK_SIZE=8388608
MUSIC_MAX_MB=64
MUSIC_THROTTLED_RATE=131072
PERSISTENT_DATA_DIR=/app/data
PGDATABASE=
PGHOST=
PGPASSWORD=
PGPORT=5432
PGUSER=
PHOTO_VERSION=0
PORT=8080
PRIMARY_BOT_ID=
PRIVATE_BROADCAST_DELAY=1
PROFILE_STATUS_ACTIONS=profile_update
PROFILE_STATUS_MAX_CHARS=700
PROFILE_STATUS_VERIFY=0
QUIET_MODE=1
RAVEN_PUBLIC_URL=
RAW_DIAGNOSTIC=0
RECONNECT_MAX_SECONDS=120
REFERRER_URL=
RIVEN_DB_NAME=talkin_bot_db
ROOM_BULK_DELAY_SECONDS=1.5
ROOM_CYCLE_DELAY_SECONDS=1.5
ROOM_EVENT_DEBUG=0
ROOM_LIST_SYNC_TIMEOUT_SECONDS=20
ROSTER_VERSION=0
RUNNING_AS_MASTER=0
SAFE_TEXT_PACKET_LIMIT=1008
SDK=35
SOCKET_PORT=5335
STOCK_MARKET_ROOM_ANNOUNCEMENTS=1
STREAM_AUTO_ACCEPT=1
STREAM_CHECK_ACTION=check_streaming
STREAM_FIRST_SUBSCRIPTION_TIMEOUT=10
STREAM_INVITE_TOKEN=Token
STREAM_LIVEKIT_READY_TIMEOUT=10
STREAM_REASSERT_DELAY=0.15
STREAM_REASSERT_SPEAKER=1
STREAM_ROOM_ID_FALLBACK_DELAY=1
SUPABASE_EMAIL=
SUPABASE_KEY=
SUPABASE_PASSWORD=
SUPABASE_URL=
TELEGRAM_CHAT_FILE=/app/data/telegram_chat_id.json
TELEGRAM_LOG_FILE=/app/data/bot_runtime.log
TELEGRAM_LONG_TEXT_CHARS=1800
TELEGRAM_POLL_ENABLED=1
USER_ID=0
VERIFICATION_ENABLED=on
WS_HEARTBEAT_SECONDS=25
WS_HOSTS=chatp.net
WS_MAX_MESSAGE_BYTES=1008
WS_PATHS=/server
